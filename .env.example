# Octo Meeting service — configuration template.
# Copy to a local .env (git-ignored) and adjust. Never commit real secrets.
# Nested config keys use "__" as the delimiter.

OCTO_MEETING_ENV=development

# HTTP
OCTO_MEETING_HTTP__ADDR=:8080
OCTO_MEETING_HTTP__BASE_PATH=/v1
OCTO_MEETING_HTTP__METRICS_ADDR=:9090
OCTO_MEETING_HTTP__READ_TIMEOUT=15s
OCTO_MEETING_HTTP__WRITE_TIMEOUT=15s

# MySQL (required) — no SQLite fallback exists.
OCTO_MEETING_MYSQL__DSN=octo:octo@tcp(localhost:3306)/octo_meeting?parseTime=true&charset=utf8mb4
OCTO_MEETING_MYSQL__MAX_OPEN_CONNS=20
OCTO_MEETING_MYSQL__MAX_IDLE_CONNS=5
OCTO_MEETING_MYSQL__CONN_MAX_LIFETIME=30m

# Redis (required)
OCTO_MEETING_REDIS__ADDR=localhost:6379
OCTO_MEETING_REDIS__PASSWORD=
OCTO_MEETING_REDIS__DB=0

# Worker
OCTO_MEETING_WORKER__CONCURRENCY=4
OCTO_MEETING_WORKER__POLL_BACKOFF=2s

# Logging
OCTO_MEETING_LOG__LEVEL=info
OCTO_MEETING_LOG__FORMAT=json

# Shutdown
OCTO_MEETING_SHUTDOWN__GRACE_PERIOD=20s

# Seams (endpoints only; not called in the bootstrap)
OCTO_MEETING_SEAMS__AUTH__BASE_URL=
OCTO_MEETING_SEAMS__SPACE__BASE_URL=
OCTO_MEETING_SEAMS__NOTIFICATION__BASE_URL=
OCTO_MEETING_SEAMS__LIVEKIT__BASE_URL=
